{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@realtime-thesis/shared-ui":              ["../../packages/shared-ui/src"],
      "@realtime-thesis/communication-adapters": ["../../packages/communication-adapters/src"]
    }
  },
  "include": [
    "src",
    "../../packages/shared-ui/src",
    "../../packages/communication-adapters/src"
  ]
}